# Secretos de las Edge Functions. En producción se cargan con:
#   npx supabase secrets set --env-file supabase/functions/.env.produccion
# (nunca subas este archivo con valores reales al repositorio)

# URL pública de la app (se usa en los enlaces del correo y para volver desde Mercado Pago)
APP_URL=https://tu-app.netlify.app

# ---- Correo electrónico: completá UNA de las dos opciones ----
# Opción A: Resend (https://resend.com)
RESEND_API_KEY=
# Opción B: SMTP (por ejemplo Gmail con "contraseña de aplicación")
# El correo sale desde la cuenta de la diplomatura (SMTP_USER y EMAIL_FROM deben ser la misma cuenta de Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=diplomaturaiaub@gmail.com
SMTP_PASS=
# Remitente que verá el cliente
EMAIL_FROM=Amarilla Gas <diplomaturaiaub@gmail.com>

# ---- Mercado Pago (https://www.mercadopago.com.ar/developers/panel/app) ----
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
